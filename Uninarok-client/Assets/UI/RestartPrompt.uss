/* SPEC-0011 FR-8 (PLAN-0011 4.11, D8): plain USS matched by eye to the original window (T0.4); no extracted images. */
.restart-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.restart-prompt {
    display: none;
    width: 280px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(90, 110, 150);
}

.restart-title {
    height: 17px;
    padding: 0 6px;
    font-size: 12px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
    background-color: rgb(205, 220, 245);
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 110, 150);
}

.restart-body {
    padding: 4px 30px 6px 30px;
}

.restart-button {
    height: 20px;
    margin: 2px 0;
    font-size: 12px;
    color: rgb(0, 0, 0);
    background-color: rgb(235, 235, 235);
    border-color: rgb(130, 130, 130);
    border-radius: 4px;
}

.restart-button:hover {
    background-color: rgb(250, 250, 250);
}
