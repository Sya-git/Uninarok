/* SPEC-0011 FR-8 (PLAN-0011 4.11, D8): plain until the original window's images are extracted (T0.4); size and layout provisional. */
.restart-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.restart-prompt {
    display: none;
    width: 200px;
    padding: 8px;
    background-color: rgb(240, 240, 240);
    border-width: 1px;
    border-color: rgb(140, 160, 200);
    border-radius: 3px;
}

.restart-button {
    height: 20px;
    margin: 2px 0;
    font-size: 12px;
    color: rgb(40, 40, 40);
    background-color: rgb(250, 250, 250);
    border-color: rgb(160, 170, 190);
    border-radius: 2px;
}

.restart-button:hover {
    background-color: rgb(225, 235, 250);
}
