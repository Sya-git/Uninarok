<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- SPEC-0011 FR-8 (PLAN-0011 4.11, D8): the death / Esc prompt. Title and labels from the original client (T0.4). -->
    <Style src="RestartPrompt.uss" />
    <ui:VisualElement name="restart-layer" picking-mode="Ignore" class="restart-layer">
        <ui:VisualElement name="restart-prompt" class="restart-prompt">
            <ui:Label name="restart-title" text="Game setting window" class="restart-title" />
            <ui:VisualElement class="restart-body">
                <ui:Button name="save-point" text="Go to saved area" class="restart-button" />
                <ui:Button name="close" text="Return to game" class="restart-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
