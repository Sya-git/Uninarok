# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
Uninarok-client/.utmp/
Uninarok-client/[Ll]ibrary/
Uninarok-client/[Tt]emp/
Uninarok-client/[Oo]bj/
Uninarok-client/[Bb]uild/
Uninarok-client/[Bb]uilds/
Uninarok-client/[Ll]ogs/
Uninarok-client/[Uu]ser[Ss]ettings/
Uninarok-client/*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
Uninarok-client/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
Uninarok-client/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Uninarok-client/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
Uninarok-client/*.DotSettings.user

# Visual Studio cache directory
Uninarok-client/.vs/

# Gradle cache directory
Uninarok-client/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
Uninarok-client/ExportedObj/
Uninarok-client/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
Uninarok-client/sysinfo.txt

# Mono auto generated files
Uninarok-client/.dirstamp
Uninarok-client/mono_crash.*
Uninarok-client/tmpinst-dir.stamp

# Builds
Uninarok-client/*_BackUpThisFolder_ButDontShipItWithYourGame/
Uninarok-client/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
Uninarok-client/crashlytics-build.properties

# Blender generated backup files
Uninarok-client/[Aa]ssets/**/*.blend1
Uninarok-client/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
Uninarok-client/[Aa]ssets/**/TDImportCache/
Uninarok-client/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
Uninarok-client/[Aa]ssets/_Recovery/
Uninarok-client/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
Uninarok-client/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
Uninarok-client/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
Uninarok-client/[Aa]ssets/AddressableAssetsData/link.xml
Uninarok-client/[Aa]ssets/AddressableAssetsData/link.xml.meta
Uninarok-client/[Aa]ssets/Addressables_Temp/
Uninarok-client/[Aa]ssets/Addressables_Temp.meta
Uninarok-client/[Aa]ssets/StreamingAssets/aa/
Uninarok-client/[Aa]ssets/StreamingAssets/aa.meta
Uninarok-client/ServerData/

# EDM4U generated files
Uninarok-client/[Aa]ssets/GeneratedLocalRepo/
Uninarok-client/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
Uninarok-client/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
Uninarok-client/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
Uninarok-client/[Aa]ssets/Resources/PerformanceTestRunInfo.json
Uninarok-client/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
Uninarok-client/[Aa]ssets/Resources/PerformanceTestRunSettings.json
Uninarok-client/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
Uninarok-client/[Aa]ssets/InitTestScene*.unity
Uninarok-client/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
Uninarok-client/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
Uninarok-client/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
Uninarok-client/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Uninarok-client/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
Uninarok-client/UIElementsSchema/

# Auto-generated cache in Assets folder
Uninarok-client/[Aa]ssets/[Ss]ceneDependencyCache*
.vs/
*.ipch
